# Example environment variables for local and cloud deployment
# Copy this file to ".env" and set secure values before deploying.

# MySQL root and user credentials (change these before production)
MYSQL_ROOT_PASSWORD=root_password_placeholder
MYSQL_USER=appuser
MYSQL_PASSWORD=app_password
MYSQL_DATABASE=projects

# Application DB connection (used by admin/dbcon.php)
DB_HOST=db
DB_USER=appuser
DB_PASS=app_password
DB_NAME=projects
